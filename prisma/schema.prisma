// shortlisted.ph — see BACKEND.md for the model rationale.
// Core principle: the snapshot is the product. Slates reference frozen
// ProfileSnapshots, never live profiles, so post-hoc profile edits can never
// change what an employer was shown.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ─── Auth (BetterAuth-owned tables) ──────────────────────────────────────

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  // talent | employer | admin. Interviewing is NOT a role — it is the
  // Interviewer row's status (see that model).
  role          String    @default("talent")
  status        String    @default("active") // active | suspended | banned
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions        Session[]
  accounts        Account[]
  talentProfile   TalentProfile?
  employer        EmployerAccount?
  notifications   Notification[]
  messages        Message[]
  reportsFiled    Report[]          @relation("ReportFiler")
  reportsAgainst  Report[]          @relation("ReportTarget")
  payments        Payment[]
  identityBinding IdentityBinding?
  referral        Referral?
  referredBy      ReferralConversion? @relation("ReferredUser")
  referralPayouts ReferralPayout[]
  interviewer     Interviewer?
  interviewsAsTalent Interview[]     @relation("InterviewTalent")

  @@index([status])
  @@map("user")
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ─── Talent ──────────────────────────────────────────────────────────────

model TalentProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  // remotetalentph JobSeekerProfile.id — makes the migration re-runnable.
  legacyId        String?   @unique
  headline        String?
  summary         String?
  city            String?
  yearsExperience Int       @default(0)
  rateUsd         Float?
  rateLockedUntil DateTime? // 30-day standing-rate lock
  availability    String    @default("open") // open | partial | booked
  committedHours  Int       @default(0)
  visibility      Boolean   @default(true)
  verifiedTier    String    @default("none") // none | id_verified
  resumeKey       String? // R2 object key

  // Collected by the onboarding gap step — only asked when the resume did not
  // answer them. All nullable: skipping any of these must never block publish.
  portfolioUrl    String?
  linkedinUrl     String?
  githubUrl       String?
  education       String?
  englishLevel    String? // native | fluent | conversational | basic
  tools           String? // free text, comma separated
  preferredOverlap String? // e.g. "4h US Eastern"
  certifications  String?

  // Live availability signal — deliberately NOT frozen into the snapshot.
  // Credentials are frozen for anti-tailoring; availability is the opposite,
  // it has to be current, so employers read it live at slate time.
  availabilityConfirmedAt DateTime? // when the talent last confirmed
  noticePeriodDays        Int? // how soon they can start if hired
  openToOffers            Boolean   @default(true)

  // Rotational matching: among candidates who clear the qualifying bar, the
  // slate favours those shown least and longest ago, so it isn't always the
  // same top profiles. Incremented + stamped when a candidate ACCEPTS a
  // consent request and lands on a slate — an unanswered invite costs nothing.
  shortlistCount Int       @default(0)
  lastShownAt    DateTime?

  // One-strike dormancy: set when a consent request expires unanswered.
  // Dormant profiles are excluded from matching until they next visit the
  // talent workspace, which clears it.
  dormantAt DateTime?

  // Extraction review signals — currently only "injection_attempt_stripped",
  // set when an uploaded resume tried to instruct the extractor. Never blocks
  // the candidate; it routes the profile to a human. See lib/resume-guard.ts.
  flags String[] @default([])

  publishedAt     DateTime?
  lastEditedAt    DateTime  @default(now())
  createdAt       DateTime  @default(now())

  // pgvector column; Prisma has no native type for it.
  embedding Unsupported("vector(1536)")?

  // Facet vectors — one per extraction group, so a JD's skill requirements
  // compare against skills, not a blended blob. `embedding` stays the
  // whole-profile vector and the hnsw pool cut; these refine ranking inside
  // the pool. Nullable: matching COALESCEs to the whole-profile distance.
  embeddingSkills     Unsupported("vector(1536)")?
  embeddingExperience Unsupported("vector(1536)")?
  embeddingPrefs      Unsupported("vector(1536)")?

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills        Skill[]
  profileTools  ProfileTool[]
  engagements   Engagement[]
  rateChanges   RateChange[]
  snapshots     ProfileSnapshot[]
  matchConsents MatchConsent[]

  @@index([publishedAt, visibility])
}

model Skill {
  id             String  @id @default(cuid())
  profileId      String
  name           String
  normalizedName String
  confirmed      Boolean @default(false) // backed by an OutcomeConfirmation

  profile TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([normalizedName])
}

// Canonical tool ownership (engine-plan 2a). One row per (profile, canonical
// tool) the alias table recognises — only KNOWN tools land here; unmapped
// skills stay prose in Skill, never guessed into a canonical. `Skill` remains
// the provenance/UI table and what the scorer reads today; ProfileTool is the
// structured store Phase 3 modifiers (recency, years) will score against.
model ProfileTool {
  id           String  @id @default(cuid())
  profileId    String
  canonicalId  String // canonicalizeTool output — the exact-match key
  name         String // as written on the profile ("QBO", "Quick Books", ...)
  years        Int?
  lastUsedYear Int?
  category     String?

  profile TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, canonicalId])
  @@index([canonicalId])
}

model Engagement {
  id        String  @id @default(cuid())
  profileId String
  role      String
  company   String
  span      String
  outcome   String  @default("reported") // confirmed | reported

  profile TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model RateChange {
  id        String   @id @default(cuid())
  profileId String
  oldRate   Float?
  newRate   Float
  changedAt DateTime @default(now())

  profile TalentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, changedAt])
}

// ─── Employer ────────────────────────────────────────────────────────────

model EmployerAccount {
  id          String   @id @default(cuid())
  userId      String   @unique
  companyName String
  blurb       String?
  location    String?
  contactName String?
  logoKey     String?
  credits     Int      @default(0) // shortlist credits — unlock a slate
  interviewCredits Int @default(0) // interview credits — book one interview each
  createdAt   DateTime @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobDescriptions JobDescription[]
  entitlements    Entitlement[]
  interviews      Interview[]
}

model JobDescription {
  id                  String    @id @default(cuid())
  employerId          String
  title               String
  budgetMin           Float?
  budgetMax           Float?
  hoursPerWeek        Int?
  overlap             String?
  mustHaves           String[]
  niceToHaves         String[]
  // Canonical tool IDs extracted from must/nice-to-haves at save time
  // (engine-plan 2a): only alias-table hits land here, unmapped requirements
  // stay prose in mustHaves/niceToHaves. Scorer still reads the prose arrays;
  // these feed Phase 3.
  requiredTools       String[]  @default([])
  preferredTools      String[]  @default([])
  screeningQuestions  Json?
  initialInstructions String?
  schedulingUrl       String?
  // draft | matching | rematching | slate_ready | no_matches | failed | closed
  status              String    @default("draft")
  publishedAt         DateTime?
  // Set when the employer closes the role — the terminal state. The public
  // openings board reads it so a filled role stops advertising itself.
  closedAt            DateTime?
  createdAt           DateTime  @default(now())

  // Stage 0 hard requirements (spec §3, engine-plan 1c): {rateMaxUsd,
  // hoursPerWeekMin, startWithinDays}. Nullable — when null and the
  // hard_filters_enabled flag is on, matching derives a default from
  // budgetMax/hoursPerWeek. Flag off = today's behaviour exactly.
  hardRequirements Json?

  // Public openings board (anonymized demand). All admin-set and nullable: a
  // JD is listable only once an admin approves a sanitized publicTitle, so the
  // board fails closed — null publicTitle means "not listed", never a leak of
  // the raw employer `title`. See docs/redesign-plan.md section 3.
  publicTitle  String? // admin-approved, sanitized. Null = not on the board.
  roleFamily   String? // controlled taxonomy: ecommerce_ops, bookkeeping, ...
  industry     String? // reuses the JD extraction industry taxonomy
  clientRegion String? // "US" | "AU" | "UK" | "EU" | "CA" — region, never a company
  listedAt     DateTime?

  embedding Unsupported("vector(1536)")?

  // Skills-facet query vector; `embedding` doubles as the role/experience query.
  embeddingSkills Unsupported("vector(1536)")?

  employer      EmployerAccount    @relation(fields: [employerId], references: [id], onDelete: Cascade)
  slates        Slate[]
  snapshots     ProfileSnapshot[]
  matchConsents MatchConsent[]
  eliminations  MatchElimination[]

  @@index([employerId, status])
  @@index([status]) // stuck-JD recovery + admin counts filter by status alone
  @@index([listedAt]) // openings board lists by recency
}

// Stage 0 eliminations, persisted per matching run (engine-plan 1c / P1-12)
// so the employer dashboard can say "N matches were above your budget
// ceiling" instead of the pool just looking thin. Rewritten on each re-run of
// a JD's matching — a log of the latest run, not an append-only history.
model MatchElimination {
  id        String   @id @default(cuid())
  jdId      String
  profileId String
  reason    String // rate_above_ceiling | hours_short | booked
  createdAt DateTime @default(now())

  jd JobDescription @relation(fields: [jdId], references: [id], onDelete: Cascade)

  @@index([jdId, reason])
}

// Consent-first matching: a slate starts empty and candidates are ASKED before
// they appear on it. The token is the whole credential — the migrated pool has
// no passwords, so the email link must work without a login. expiresAt is set
// at SEND time (sentAt + 48h) and stays null until the email actually goes out,
// so a consent suppressed by the outreach kill switch can never expire anyone.
// The invite carries the frozen ranking. Score, dims, reasons and the snapshot
// are all computed ONCE, at invite time, before the candidate has seen the
// job's must-haves — accepting only copies them onto the slate. That is what
// makes anti-tailoring literal: there is no post-disclosure scoring event to
// game, and the score the employer sees is the score that qualified them.
model MatchConsent {
  id          String    @id @default(cuid())
  jdId        String
  profileId   String
  slateId     String? // the slate this invite fills; null only for pre-binding rows
  snapshotId  String? // profile frozen at invite time
  score       Int?
  dims        Json? // { skills, rate, overlap, experience } as ranked
  reasons     String[] @default([])
  status      String    @default("pending") // pending | accepted | declined | expired
  token       String    @unique
  sentAt      DateTime?
  respondedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  jd       JobDescription   @relation(fields: [jdId], references: [id], onDelete: Cascade)
  profile  TalentProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  slate    Slate?           @relation(fields: [slateId], references: [id], onDelete: Cascade)
  snapshot ProfileSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  @@unique([jdId, profileId])
  @@index([status, expiresAt])
  @@index([slateId, status])
}

// ─── Slates (the product) ────────────────────────────────────────────────

model ProfileSnapshot {
  id         String   @id @default(cuid())
  profileId  String
  jdId       String
  // Full profile as it existed when the candidate was INVITED — before they
  // were shown the job's must-haves. Never re-frozen on accept.
  frozenJson Json
  createdAt  DateTime @default(now())

  profile  TalentProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jd       JobDescription @relation(fields: [jdId], references: [id], onDelete: Cascade)
  entries  SlateEntry[]
  consents MatchConsent[]

  @@unique([profileId, jdId])
}

model Slate {
  id          String    @id @default(cuid())
  jdId        String
  status      String    @default("preview") // pending_review | preview | unlocked
  unlockedAt  DateTime?
  deliveredAt DateTime  @default(now())

  jd       JobDescription @relation(fields: [jdId], references: [id], onDelete: Cascade)
  entries  SlateEntry[]
  consents MatchConsent[]

  @@index([jdId])
  @@index([status]) // admin dashboard counts filter by status alone
}

model SlateEntry {
  id         String   @id @default(cuid())
  slateId    String
  snapshotId String
  rank       Int
  score      Int
  dims       Json // { skills, rate, overlap, experience }
  reasons    String[]

  slate      Slate            @relation(fields: [slateId], references: [id], onDelete: Cascade)
  snapshot   ProfileSnapshot  @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  connection Connection?
  interviews Interview[]

  @@index([slateId, rank])
}

// ─── Relationship layer ──────────────────────────────────────────────────

model Connection {
  id                String    @id @default(cuid())
  slateEntryId      String    @unique
  state             String    @default("requested") // requested | consented | declined | expired
  screeningAnswers  Json?
  contactRevealedAt DateTime?
  createdAt         DateTime  @default(now())

  slateEntry SlateEntry @relation(fields: [slateEntryId], references: [id], onDelete: Cascade)
  agreement  Agreement?
  messages   Message[]

  @@index([state])
}

model Agreement {
  id              String    @id @default(cuid())
  connectionId    String    @unique
  terms           Json
  talentSignedAt  DateTime?
  employerSignedAt DateTime?
  pdfKey          String?
  createdAt       DateTime  @default(now())

  connection  Connection            @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  outcomes    OutcomeConfirmation[]
  ratings     Rating[]
}

model OutcomeConfirmation {
  id               String    @id @default(cuid())
  agreementId      String
  period           String // e.g. "2026-09"
  talentConfirmedAt   DateTime?
  employerConfirmedAt DateTime?

  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@unique([agreementId, period])
}

model Rating {
  id          String    @id @default(cuid())
  agreementId String
  direction   String // talent_to_employer | employer_to_talent
  stars       Int
  categories  Json?
  comment     String?
  revealedAt  DateTime? // double-blind: set when both sides rate, or after 14d
  createdAt   DateTime  @default(now())

  agreement Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@unique([agreementId, direction])
}

model Message {
  id           String   @id @default(cuid())
  connectionId String
  senderId     String
  body         String
  createdAt    DateTime @default(now())

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  sender     User       @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt])
}

// ─── Money, trust, ops ───────────────────────────────────────────────────

// One row per credit granted — the ledger behind EmployerAccount.credits /
// interviewCredits. Every movement is recorded here: spent (on a slate or an
// interview) or revoked (refund, admin deduction). count(unspent, unrevoked)
// must always equal the balance; a drift means a path skipped the ledger.
model Entitlement {
  id                 String    @id @default(cuid())
  employerId         String
  kind               String    @default("credit") // credit | interview_credit
  source             String // provider ref, or admin_grant
  spentOnSlateId     String?
  spentOnInterviewId String?
  // Set when a refund or admin deduction takes the credit back. Revoked rows
  // are never re-spendable and never counted toward the balance.
  revokedAt          DateTime?
  revokedReason      String?
  createdAt          DateTime  @default(now())

  employer EmployerAccount @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@index([employerId])
  @@index([employerId, kind, revokedAt])
  @@index([source])
}

model Payment {
  id          String   @id @default(cuid())
  userId      String
  provider    String // paypal | paymongo
  providerRef String   @unique
  // Decimal, never Float: this column is summed in SQL for revenue reporting,
  // and IEEE doubles accumulate cent errors under aggregation.
  amount      Decimal  @db.Decimal(10, 2)
  currency    String
  purpose     String // a ProductId: single | three_pack | interview_single | interview_five | verification
  status      String   @default("pending")
  refundedAt  DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// No identity documents are ever stored — only an opaque provider reference
// and a face embedding used to stop banned users re-registering.
//
// status is the review state of the verification ATTEMPT. Paying only buys the
// attempt; an admin (or, later, an automated provider callback) sets verified,
// which is the only thing that writes TalentProfile.verifiedTier. Paying must
// never be enough to look verified.
model IdentityBinding {
  id               String    @id @default(cuid())
  userId           String    @unique
  status           String    @default("pending") // pending | verified | rejected
  diditSessionRef  String?
  faceEmbeddingRef String?
  note             String? // admin's reason on reject
  reviewedAt       DateTime?
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Report {
  id           String   @id @default(cuid())
  filedById    String
  againstId    String
  reason       String
  detail       String
  evidenceKeys String[]
  status       String   @default("open") // open | resolved | dismissed
  resolution   String?
  createdAt    DateTime @default(now())

  filedBy User @relation("ReportFiler", fields: [filedById], references: [id], onDelete: Cascade)
  against User @relation("ReportTarget", fields: [againstId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([filedById])
  @@index([againstId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// Operator-controlled switches, e.g. the outreach-email kill switch used while
// testing with real data. Key-value keeps it one table for all of them.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─── Referrals / affiliate ───────────────────────────────────────────────

// One link per user. Campaign splitting rides on the ?s= tag recorded per
// click, so affiliates get per-campaign numbers without juggling codes.
model Referral {
  id        String   @id @default(cuid())
  userId    String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Where to send the money. Nullable because an affiliate exists long before
  // they have anything to be paid. payoutAccountNumber is the sensitive one:
  // never logged, never in an audit meta blob, masked to the last 4 in admin.
  payoutMethod        String? // paypal — the allowed set is PAYOUT_METHODS in lib/referral.ts
  payoutAccountName   String?
  payoutAccountNumber String?

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  clicks      ReferralClick[]
  conversions ReferralConversion[]
  commissions ReferralCommission[]
}

// One row per qualifying purchase by a referred company — the recurring $9.
// The conversion row above is the attribution (who referred whom, once);
// commissions are the money, accruing on every shortlist-credit purchase for
// the lifetime of the referred company. paymentId is the provider reference,
// unique so a replayed webhook can never pay twice.
model ReferralCommission {
  id           String   @id @default(cuid())
  referralId   String
  conversionId String
  paymentId    String   @unique
  amount       Decimal  @db.Decimal(10, 2)
  currency     String
  createdAt    DateTime @default(now())

  // Set when a payout covering this commission is requested, cleared if that
  // payout is rejected. Null means "still owed".
  payoutId String?

  // Set when the underlying purchase was refunded or the conversion voided. A
  // voided commission is excluded from every balance — but the row survives, so
  // "earned" history never silently rewrites itself.
  voidedAt     DateTime?
  voidedReason String?

  referral   Referral           @relation(fields: [referralId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: deleting a referred user used to cascade
  // user → conversion → commission and silently destroy money history,
  // including commissions already inside a PAID payout — leaving "earned"
  // below "paid" with no trace. Any future delete path must deal with the
  // money explicitly instead of quietly winning the race.
  conversion ReferralConversion @relation(fields: [conversionId], references: [id], onDelete: Restrict)
  payout     ReferralPayout?    @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([referralId, payoutId])
  @@index([conversionId])
}

// ipHash, never the raw address: enough to spot self-clicking, not enough to
// be personal data we have to defend.
model ReferralClick {
  id         String   @id @default(cuid())
  referralId String
  source     String?
  ipHash     String?
  userAgent  String?
  createdAt  DateTime @default(now())

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([referralId, createdAt])
}

// Unique on userId: a person can only ever be referred once, by one affiliate.
model ReferralConversion {
  id           String    @id @default(cuid())
  referralId   String
  userId       String    @unique
  source       String?
  status       String    @default("signed_up") // signed_up | qualified | void
  // Attribution-era history. Money moved to ReferralCommission when the model
  // became recurring; nothing writes or aggregates these four any more. They
  // survive so pre-migration rows still explain themselves — do not add a
  // reader, or two things start claiming to hold "the reward".
  rewardAmount Decimal?  @db.Decimal(10, 2)
  currency     String?
  paymentId    String?
  qualifiedAt  DateTime?
  createdAt    DateTime  @default(now())

  // Set when a payout covering this conversion is requested, cleared if that
  // payout is rejected. Null on a qualified row means "still owed" — that is
  // the whole unpaid balance calculation, no arithmetic across payouts.
  payoutId String?

  referral    Referral             @relation(fields: [referralId], references: [id], onDelete: Cascade)
  user        User                 @relation("ReferredUser", fields: [userId], references: [id], onDelete: Cascade)
  payout      ReferralPayout?      @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  commissions ReferralCommission[]

  @@index([referralId, status])
  @@index([payoutId])
}

model ReferralPayout {
  id        String    @id @default(cuid())
  userId    String
  amount    Decimal   @db.Decimal(10, 2)
  currency  String    @default("PHP")
  method    String // gcash | bank
  reference String?
  status    String    @default("pending") // pending | paid | rejected
  note      String?
  createdAt DateTime  @default(now())
  paidAt    DateTime?

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversions ReferralConversion[]
  commissions ReferralCommission[]

  @@index([userId, status])
  @@index([status])
}

// Anonymous top-of-funnel intake. An employer describes a role and sees a live
// prospect count BEFORE signing up; the draft is keyed by a cookie token and
// claimed into a real JobDescription once they create an account. No PII —
// this holds role requirements only, so an abandoned draft is not personal data.
model JobDraft {
  id            String   @id @default(cuid())
  token         String   @unique
  title         String?
  rawText       String?  // pasted or free-written role, before parsing
  budgetMin     Float?
  budgetMax     Float?
  hoursPerWeek  Int?
  overlap       String?
  mustHaves     String[]
  matchCount    Int? // snapshot of prospects shown, for lead analytics
  claimedByJdId String? // set when a signed-up employer turns this into a JD
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdAt])
}

// ─── Interviews (pay-per-interview) ──────────────────────────────────────

// A vetted person who runs paid interviews. Not self-serve: an application
// sets status "pending", an admin flips it to "active". rateUsd is their
// payout per completed interview; the employer pays that plus a platform fee.
model Interviewer {
  id              String   @id @default(cuid())
  userId          String   @unique
  bio             String?
  expertise       String[] // domains, e.g. ["react", "customer support"]
  languages       String[]
  yearsExperience Int      @default(0)
  rateUsd         Float    @default(8) // 5–10, enforced in app
  // pending | active | paused | revoked. This row — NOT User.role — is what
  // grants the interviewer portal. Interviewing is a capability someone holds
  // alongside being talent or an employer; flipping User.role would strand
  // their real account (no talent routes, no employer credits).
  status          String   @default("pending")
  avatarKey       String?
  createdAt       DateTime @default(now())

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviews Interview[]
  payouts    InterviewerPayout[]

  @@index([status])
}

model Interview {
  id            String @id @default(cuid())
  // Ties the interview to the employer's unlocked shortlist entry and, through
  // the snapshot, to the talent being interviewed.
  slateEntryId  String
  employerId    String
  interviewerId String
  talentUserId  String
  status        String @default("requested")
  // requested → consented → paid → scheduled → recorded → reported
  //           ↘ declined (candidate said no; never charged)   ↘ cancelled
  // Both amounts locked at request time so a later rate change can't move a
  // price the employer already saw.
  priceUsd             Decimal @db.Decimal(10, 2)
  interviewerPayoutUsd Decimal @db.Decimal(10, 2)
  // Set by the employer at request time — the interviewer sees these before
  // and during the call. Optional: a request is valid with neither.
  suggestedQuestions String[]
  employerNotes      String?
  scheduledAt  DateTime?
  recordingKey String? // R2 object key, uploaded by the interviewer
  paymentRef   String? // Payment.providerRef once the employer pays
  payoutId     String?
  createdAt    DateTime @default(now())

  slateEntry  SlateEntry           @relation(fields: [slateEntryId], references: [id], onDelete: Cascade)
  employer    EmployerAccount      @relation(fields: [employerId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: historical interviews must survive an interviewer
  // ever being deleted — delete paths must handle this explicitly.
  interviewer Interviewer          @relation(fields: [interviewerId], references: [id], onDelete: Restrict)
  talent      User                 @relation("InterviewTalent", fields: [talentUserId], references: [id], onDelete: Cascade)
  assessment  InterviewAssessment?
  payout      InterviewerPayout?   @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([employerId, status])
  @@index([interviewerId, status])
  @@index([talentUserId, status])
  @@index([payoutId])
  @@index([status])
}

// Our fixed template, filled by the interviewer. Fixed fields so every report
// renders identically and can be compared across candidates.
model InterviewAssessment {
  id             String   @id @default(cuid())
  interviewId    String   @unique
  recommendation String // strong_yes | yes | lean_yes | no
  overall        Int // 1–5
  technical      Int // 1–5
  communication  Int // 1–5
  englishFluency Int // 1–5
  strengths      String
  concerns       String
  notes          String?
  submittedAt    DateTime @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
}

// Earned in USD, settled to PHP by hand — same manual rail as referral payouts.
model InterviewerPayout {
  id            String    @id @default(cuid())
  interviewerId String
  amount        Decimal   @db.Decimal(10, 2)
  currency      String    @default("USD")
  method        String // gcash | bank
  reference     String?
  status        String    @default("pending") // pending | paid | rejected
  note          String?
  createdAt     DateTime  @default(now())
  paidAt        DateTime?

  interviewer Interviewer @relation(fields: [interviewerId], references: [id], onDelete: Cascade)
  interviews  Interview[]

  @@index([interviewerId, status])
  @@index([status])
}
